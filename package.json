{
  "name": "adblocker",
  "version": "1.7.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:dom": "node tests/dom.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "test:dist": "node --test tests/distribution.mjs",
    "lint:firefox": "npm exec --yes --package=web-ext@10.8.0 -- web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "build:stores": "node scripts/build.mjs --store",
    "package:stores": "npm run build:stores && node scripts/package.mjs --store",
    "test:stores": "node --test tests/stores.mjs",
    "test:store-browser": "node tests/store-browser.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "store:kit": "node scripts/store-kit.mjs",
    "locales": "node scripts/localize.mjs",
    "check:locales": "node scripts/localize.mjs --check",
    "test:firefox": "node tests/firefox-runtime.mjs",
    "test:youtube": "node tests/youtube.mjs && node tests/youtube-browser.mjs",
    "test:youtube-live": "node tests/youtube-live.mjs",
    "store:fields": "node scripts/store-fields.mjs",
    "check:store-fields": "node scripts/store-fields.mjs --check",
    "test:store-kit": "node tests/store-kit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
