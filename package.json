{
  "name": "adblocker",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:dom": "node tests/dom.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "test:dist": "node --test tests/distribution.mjs",
    "lint:firefox": "npm exec --yes --package=web-ext@10.8.0 -- web-ext lint --source-dir dist/firefox --warnings-as-errors"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
